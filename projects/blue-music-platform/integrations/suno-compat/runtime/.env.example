# Blue Music isolated compatibility runtime
# Copy to .env.local (never commit .env.local)

# Suno login session cookie. Prefer scripts/set-suno-cookie.ps1 (hidden input)
# over editing this file by hand. Either plain or base64 form works.
SUNO_COOKIE=
# SUNO_COOKIE_BASE64=

# Internal Bearer token required on every request (see src/middleware.ts)
INTERNAL_API_TOKEN=

# 2Captcha API key for automatic hCaptcha solving (paid service).
# Leave empty to fall back to the manual human-verification flow.
TWOCAPTCHA_KEY=

# Solver browser settings (only used when TWOCAPTCHA_KEY is set)
BROWSER=chromium
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true

# Bind address and port. Keep 127.0.0.1 for local-only isolation.
COMPAT_HOST=127.0.0.1
COMPAT_PORT=3000
