DATABASE_URL=postgresql://blue_music:blue_music_pass@localhost:5432/blue_music_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
ENVIRONMENT=development
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_FILE=true
LOG_DIR=
LOG_RETENTION_DAYS=30
RANKING_RETENTION_DAYS=30
RANKING_DEFAULT_LIMIT=100
KUGOU_REQUEST_TIMEOUT_SECONDS=15
KUGOU_MAX_RETRIES=3
# local keeps development and tests free. Use openai_compatible after choosing a text model.
AI_PROVIDER=local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Stable key used to encrypt database-stored provider credentials. Never rotate it casually.
AI_CONFIG_ENCRYPTION_KEY=replace_with_another_stable_random_secret
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2
# Suno official Platform credentials. Keep blank until API access is granted.
SUNO_PROVIDER_IMPLEMENTATION=official
SUNO_API_BASE_URL=
SUNO_API_KEY=
SUNO_MODEL=
# Unofficial compatibility service. Disabled by default and only allowed on
# localhost/Docker internal networking. The Suno cookie belongs to that isolated
# service and must never be placed in Blue Music.
SUNO_COMPAT_ENABLED=false
SUNO_COMPAT_BASE_URL=http://suno-compat:3000
SUNO_COMPAT_SHARED_TOKEN=
SUNO_COMPAT_MODEL=
SUNO_COMPAT_ALLOW_REMOTE=false
SUNO_REQUEST_TIMEOUT_SECONDS=120
SUNO_GENERATION_TIMEOUT_SECONDS=900
SUNO_POLL_INTERVAL_SECONDS=30
SUNO_DOWNLOAD_TIMEOUT_SECONDS=120
SUNO_MAX_AUDIO_BYTES=104857600
MUSIC_QUEUE_MODE=redis
MUSIC_QUEUE_NAME=blue_music:music:queue
MUSIC_MAX_CONCURRENCY=1
MUSIC_MIN_REQUEST_INTERVAL_SECONDS=30
MUSIC_MAX_RETRIES=3
MUSIC_RETRY_BASE_SECONDS=30
MUSIC_RETRY_MAX_SECONDS=600
MUSIC_WORKER_RESERVE_SECONDS=5
SUNO_QUOTA_REFRESH_INTERVAL_SECONDS=300
MUSIC_STORAGE_BACKEND=local
MUSIC_STORAGE_DIR=
# Optional S3-compatible object storage for cloud deployment.
MUSIC_S3_ENDPOINT_URL=
MUSIC_S3_BUCKET=
MUSIC_S3_REGION=us-east-1
MUSIC_S3_ACCESS_KEY=
MUSIC_S3_SECRET_KEY=
MUSIC_S3_PREFIX=blue-music
MUSIC_S3_PRESIGN_SECONDS=900
# Leave a short gap between text AI steps to reduce free-tier rate limiting.
WORKFLOW_STEP_DELAY_SECONDS=15
WORKFLOW_STALE_SECONDS=1800
INITIAL_SUPERADMIN_USERNAME=admin
# Set INITIAL_SUPERADMIN_PASSWORD only for one-time automated deployment.
